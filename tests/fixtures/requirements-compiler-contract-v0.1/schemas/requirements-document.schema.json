{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptrig.dev/contracts/requirements-compiler/v0.1/requirements-document.schema.json",
  "title": "Requirements Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "document_id", "input_ref", "requirements", "sources", "assumptions", "open_questions", "conflicts"],
  "properties": {
    "contract_version": {"const": "0.1.0-draft"},
    "document_id": {"type": "string", "pattern": "^RQD-[A-Z0-9-]+$"},
    "input_ref": {"type": "string", "pattern": "^INP-[A-Z0-9-]+$"},
    "requirements": {"type": "array", "items": {"$ref": "requirement.schema.json"}, "minItems": 1},
    "sources": {"type": "array", "items": {"$ref": "source-evidence.schema.json"}, "minItems": 1},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}, "uniqueItems": true},
    "open_questions": {"type": "array", "items": {"$ref": "#/$defs/question"}, "uniqueItems": true},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}, "uniqueItems": true},
    "defaults": {"type": "array", "items": {"$ref": "#/$defs/default"}, "uniqueItems": true},
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}, "uniqueItems": true},
    "model_proposals": {"type": "array", "items": {"$ref": "#/$defs/model_proposal"}, "uniqueItems": true},
    "derivations": {"type": "array", "items": {"$ref": "#/$defs/derivation"}, "uniqueItems": true},
    "test_mappings": {"type": "array", "items": {"$ref": "#/$defs/test_mapping"}, "uniqueItems": true},
    "policies": {"type": "array", "items": {"$ref": "#/$defs/policy"}, "uniqueItems": true},
    "validations": {"type": "array", "items": {"$ref": "#/$defs/validation_record"}, "uniqueItems": true},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap_record"}, "uniqueItems": true},
    "external_evidence": {"type": "array", "items": {"$ref": "#/$defs/external_evidence"}, "uniqueItems": true}
  },
  "$defs": {
    "assumption": {
      "description": "RC-030 (OQ-008-010 resolved structured-only, owner decision): a canonical assumption is a structured record with stable identity, statement, impact, source references, acceptance state, and consequential flag. Bare strings are no longer canonical assumption records; the 41 semantic-oracle fixtures remain a compact test-only projection, not a canonical requirements document.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "impact", "source_refs", "acceptance_state", "consequential"],
      "properties": {
        "id": {"type": "string", "pattern": "^ASM-[A-Z0-9-]+$"},
        "statement": {"type": "string", "minLength": 1},
        "impact": {"enum": ["required", "optional"]},
        "source_refs": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
        "acceptance_state": {"enum": ["proposed", "accepted", "disputed", "unresolved", "unsupported", "refused", "invalid"]},
        "consequential": {"type": "boolean"},
        "approval_refs": {"type": "array", "items": {"type": "string", "pattern": "^APR-[A-Z0-9-]+$"}, "uniqueItems": true}
      },
      "allOf": [
        {
          "$comment": "RC-031/AD-023: a consequential assumption requires at least one approval reference (semantically resolved to a valid active APR record).",
          "if": {"properties": {"consequential": {"const": true}}, "required": ["consequential"]},
          "then": {"required": ["approval_refs"], "properties": {"approval_refs": {"minItems": 1}}}
        }
      ]
    },
    "question": {
      "description": "EM-020/RC-035 Question record: stable ID, text, affected requirements, required/optional impact, and resolution state. Structured-only (OQ-008-010 resolved). resolution_evidence is required once resolution_state is resolved.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "affected_requirement_refs", "impact", "resolution_state"],
      "properties": {
        "id": {"type": "string", "pattern": "^OQN-[A-Z0-9-]+$"},
        "text": {"type": "string", "minLength": 1},
        "affected_requirement_refs": {"type": "array", "items": {"type": "string", "pattern": "^REQ-[A-Z0-9-]{3,64}$"}, "minItems": 1, "uniqueItems": true},
        "impact": {"enum": ["required", "optional"]},
        "resolution_state": {"enum": ["unresolved", "resolved"]},
        "resolution_evidence": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "$comment": "A resolved question must carry its resolution evidence; an unresolved question explicitly does not (and blocks required meaning per RC-035).",
          "if": {"properties": {"resolution_state": {"const": "resolved"}}, "required": ["resolution_state"]},
          "then": {"required": ["resolution_evidence"]}
        }
      ]
    },
    "conflict": {
      "description": "RC-033/EM-020: preserves all claims, sources, authority levels, affected requirements, and resolution status. All are required evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement_ids", "claims", "source_ids", "authority_ranks", "resolution_state"],
      "properties": {
        "id": {"type": "string", "pattern": "^CFL-[A-Z0-9-]+$"},
        "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^REQ-[A-Z0-9-]{3,64}$"}, "minItems": 1, "uniqueItems": true},
        "claims": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 2, "uniqueItems": true},
        "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
        "authority_ranks": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "resolution_state": {"enum": ["unresolved", "resolved"]}
      }
    },
    "default": {
      "description": "AD-020/RC-040: a default record has stable ID, statement, authority reference, scope, affected requirement IDs, consequential flag, approval state, and source references. `approved` is NOT an independent authority signal (refinement 2): when consequential, approval_refs must resolve to a valid active APR record and `approved` must equal that resolution (enforced semantically).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "authority_ref", "scope", "affected_requirement_refs", "source_refs", "consequential", "approved"],
      "properties": {
        "id": {"type": "string", "pattern": "^DFT-[A-Z0-9-]+$"},
        "authority_ref": {"type": "string", "minLength": 1},
        "consequential": {"type": "boolean"},
        "approved": {"type": "boolean"},
        "statement": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "affected_requirement_refs": {"type": "array", "items": {"type": "string", "pattern": "^REQ-[A-Z0-9-]{3,64}$"}, "minItems": 1, "uniqueItems": true},
        "source_refs": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
        "approval_refs": {"type": "array", "items": {"type": "string", "pattern": "^APR-[A-Z0-9-]+$"}, "uniqueItems": true}
      },
      "allOf": [
        {
          "$comment": "AD-023/AD-025/SP-015: a consequential default requires at least one approval reference; a bare approved boolean never authorizes.",
          "if": {"properties": {"consequential": {"const": true}}, "required": ["consequential"]},
          "then": {"required": ["approval_refs"], "properties": {"approval_refs": {"minItems": 1}}}
        }
      ]
    },
    "approval": {
      "description": "EM-020/AD-050/SP-020/RC-044: the approval record is the source of authorization truth. It must name the accepted policy it was granted under (`policy_ref`) and resolve its evidence through `evidence_refs`; an arbitrary non-empty string never authorizes. Approvals are reusable authority evidence, not attempt-bound, so they are immutable and content-addressed via `content_digest`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject_refs", "authority", "decision", "scope", "evidence_refs", "policy_ref", "sequence", "content_digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^APR-[A-Z0-9-]+$"},
        "subject_refs": {"type": "array", "items": {"type": "string", "pattern": "^(REQ-[A-Z0-9-]{3,64}|ASM-[A-Z0-9-]+|DFT-[A-Z0-9-]+|MAP-[A-Z0-9-]+)$"}, "minItems": 1, "uniqueItems": true},
        "authority": {"enum": ["owner", "user"]},
        "decision": {"enum": ["approved", "rejected", "revoked", "expired", "superseded"]},
        "scope": {"$ref": "#/$defs/scope"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^(SRC-[A-Z0-9-]+|EXT-[A-Z0-9-]+)$"}, "minItems": 1, "uniqueItems": true, "description": "Resolves to preserved source evidence or governed external evidence carrying a URI and SHA-256."},
        "policy_ref": {"type": "string", "pattern": "^POL-[A-Z0-9-]+$", "description": "The accepted approval-threshold policy this approval was granted under. Authorization requires this chain to resolve end to end."},
        "sequence": {"type": "integer", "minimum": 0},
        "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 over canonical JSON of this record with `content_digest` removed. Non-circular by construction."}
      }
    },
    "scope": {
      "description": "AD-050/SP-020: machine-readable approval scope. Scope coverage is an exact (kind, value) match against the subject; membership in `subject_refs` alone is never scope coverage.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["requirement", "assumption", "default", "mapping", "operation", "policy"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "description": "AD-023/SP-025: an accepted governing policy. `approval_threshold` policies define the authority required for a consequential subject; `prohibition` policies are the only thing that can turn a fail-closed result into REFUSED. A policy is reusable authority evidence: immutable, content-addressed, and anchored to an authoritative source with exact version and digest.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "statement", "scope", "source_ref", "content_digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^POL-[A-Z0-9-]+$"},
        "kind": {"enum": ["approval_threshold", "prohibition"]},
        "status": {"enum": ["accepted", "proposed", "withdrawn"]},
        "statement": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/scope"},
        "required_authority": {"enum": ["owner", "user", "owner_or_user", "owner_and_user"]},
        "source_ref": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$", "description": "The authoritative accepted-contract or decision source carrying this policy, with exact identity, version, and digest."},
        "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "allOf": [
        {
          "$comment": "An approval-threshold policy must state the authority it requires; `any` is not a permitted value.",
          "if": {"properties": {"kind": {"const": "approval_threshold"}}, "required": ["kind"]},
          "then": {"required": ["required_authority"]}
        }
      ]
    },
    "validation_record": {
      "description": "EM-013/RC-114: an immutable, content-addressable validation record that mapping and derivation evidence resolves to.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "validator_version", "result", "content_digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^VAL-[A-Z0-9-]+$"},
        "validator_version": {"type": "string", "minLength": 1},
        "result": {"enum": ["PASS", "FAIL"]},
        "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "gap_record": {
      "description": "RC-105/TR-008: a preserved IR v0.1 representation gap carrying its diagnostic and planning disposition.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement_ref", "summary", "diagnostic_code", "disposition"],
      "properties": {
        "id": {"type": "string", "pattern": "^IRG-[A-Z0-9-]+$"},
        "requirement_ref": {"type": "string", "pattern": "^REQ-[A-Z0-9-]{3,64}$"},
        "summary": {"type": "string", "minLength": 1},
        "diagnostic_code": {"const": "RQC-IRG-0001"},
        "disposition": {"type": "string", "minLength": 1}
      }
    },
    "external_evidence": {
      "description": "EM-014: evidence held outside the bundle. Permitted only when explicitly governed and content-addressed by URI and SHA-256.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri", "sha256", "governed_by"],
      "properties": {
        "id": {"type": "string", "pattern": "^EXT-[A-Z0-9-]+$"},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "governed_by": {"type": "string", "pattern": "^POL-[A-Z0-9-]+$"}
      }
    },
    "model_proposal": {
      "description": "EM-020/RC-072/AD-040-041: a model proposal is unaccepted evidence. It preserves input/output digest and proposed records; producer identity/version are 'when known' and optional. acceptance_state may NEVER be accepted (B1) — model output cannot self-accept. self_accepted/weakens_security are adversarial-detection markers, not acceptance authority, and gate nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_refs", "acceptance_state", "input_digest", "output_digest", "proposed_records"],
      "properties": {
        "id": {"type": "string", "pattern": "^MDL-[A-Z0-9-]+$"},
        "source_refs": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
        "acceptance_state": {"enum": ["proposed", "disputed", "unresolved", "unsupported", "refused", "invalid"]},
        "self_accepted": {"type": "boolean"},
        "weakens_security": {"type": "boolean"},
        "producer_identity": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "minLength": 1},
        "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "proposed_records": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      }
    },
    "derivation": {
      "description": "EM-020/AD-030: stable ID, rule/clause, input refs, output refs, deterministic validation ref.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "input_refs", "output_refs", "validation_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^DRV-[A-Z0-9-]+$"},
        "rule_id": {"type": "string", "minLength": 1},
        "input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "output_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "validation_ref": {"type": "string", "pattern": "^VAL-[A-Z0-9-]+$"}
      }
    },
    "test_mapping": {
      "description": "EM-020: stable ID, requirement/clause, planned test/evidence ID, status.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "planned_evidence_id", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^TSM-[A-Z0-9-]+$"},
        "requirement_ref": {"type": "string", "pattern": "^REQ-[A-Z0-9-]{3,64}$"},
        "clause_ref": {"type": "string", "pattern": "^(RC|EM|AD|TR|DG|SP)-\\d{3}$"},
        "planned_evidence_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "satisfied", "unresolved"]}
      }
    }
  }
}
