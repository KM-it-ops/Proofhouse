{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptrig.dev/contracts/requirements-compiler/v0.1/requirement-ir-mapping.schema.json",
  "title": "Requirement to IR Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "requirement_id", "outcome", "authority_ref", "validation_ref"],
  "properties": {
    "id": {"type": "string", "pattern": "^MAP-[A-Z0-9-]+$"},
    "requirement_id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]{3,64}$"},
    "outcome": {"enum": ["direct", "deterministic_derivation", "authorized_default", "unresolved", "prohibited", "no_ir_representation"]},
    "target_pointer": {"type": "string", "pattern": "^/"},
    "authority_ref": {"type": "string", "minLength": 1},
    "validation_ref": {"type": "string", "pattern": "^VAL-[A-Z0-9-]+$"},
    "diagnostic_code": {"type": "string", "pattern": "^RQC-[A-Z]{3}-[0-9]{4}$"},
    "gap_id": {"type": "string", "pattern": "^IRG-[A-Z0-9-]+$"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"enum": ["direct", "deterministic_derivation", "authorized_default"]}}},
      "then": {"required": ["target_pointer"]}
    },
    {
      "if": {"properties": {"outcome": {"const": "no_ir_representation"}}},
      "then": {"required": ["diagnostic_code", "gap_id"]}
    }
  ]
}
