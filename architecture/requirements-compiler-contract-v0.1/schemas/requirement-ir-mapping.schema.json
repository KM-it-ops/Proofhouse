{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptrig.dev/contracts/requirements-compiler/v0.1/requirement-ir-mapping.schema.json",
  "title": "Requirement to IR Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "requirement_id", "outcome", "authority_ref", "validation_ref"],
  "properties": {
    "id": {"type": "string", "pattern": "^MAP-[A-Z0-9-]+$"},
    "requirement_id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]{3,64}$"},
    "outcome": {"enum": ["direct", "deterministic_derivation", "authorized_default", "unresolved", "prohibited", "no_ir_representation"]},
    "target_pointer": {"type": "string", "pattern": "^/"},
    "authority_ref": {
      "description": "TR-003: the authority behind this mapping, named by exact record kind and identity so it resolves to a real record. A free-text authority label is not resolvable evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["source", "default", "derivation", "approval", "policy"]},
        "ref": {"type": "string", "pattern": "^(SRC|DFT|DRV|APR|POL)-[A-Z0-9-]+$"}
      }
    },
    "validation_ref": {"type": "string", "pattern": "^VAL-[A-Z0-9-]+$", "description": "Resolves to an immutable validation record."},
    "diagnostic_code": {"type": "string", "pattern": "^RQC-[A-Z]{3}-[0-9]{4}$"},
    "gap_id": {"type": "string", "pattern": "^IRG-[A-Z0-9-]+$"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"enum": ["direct", "deterministic_derivation", "authorized_default"]}}, "required": ["outcome"]},
      "then": {"required": ["target_pointer"]}
    },
    {
      "if": {"properties": {"outcome": {"const": "no_ir_representation"}}, "required": ["outcome"]},
      "then": {"required": ["diagnostic_code", "gap_id"]}
    },
    {
      "$comment": "TR-003: each emitting outcome admits only the authority kinds that can license it.",
      "if": {"properties": {"outcome": {"const": "deterministic_derivation"}}, "required": ["outcome"]},
      "then": {"properties": {"authority_ref": {"properties": {"kind": {"const": "derivation"}}}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "authorized_default"}}, "required": ["outcome"]},
      "then": {"properties": {"authority_ref": {"properties": {"kind": {"const": "default"}}}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "direct"}}, "required": ["outcome"]},
      "then": {"properties": {"authority_ref": {"properties": {"kind": {"enum": ["source", "approval"]}}}}}
    },
    {
      "$comment": "RC-106/EM-033: a prohibited mapping is licensed by the controlling policy.",
      "if": {"properties": {"outcome": {"const": "prohibited"}}, "required": ["outcome"]},
      "then": {"properties": {"authority_ref": {"properties": {"kind": {"const": "policy"}}}}}
    }
  ]
}
