      "segoeuib.ttf",
      "DejaVuSans-Bold.ttf",
      "LiberationSans-Bold.ttf"
    ],
    "mono": [
      {"file": "CascadiaMono.ttf", "variation": "Regular"},
      "consola.ttf",
