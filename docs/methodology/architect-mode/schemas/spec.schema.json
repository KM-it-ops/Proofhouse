{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architect Mode Specification",
  "type": "object",
  "required": [
    "version",
    "id",
    "title",
    "objective",
    "requirements",
    "acceptance_criteria"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^SPEC-[0-9]{3,}$"
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
