{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architect Mode Mission",
  "type": "object",
  "required": [
    "version",
    "id",
    "title",
    "objective",
    "deliverables",
    "acceptance_criteria",
    "stop_conditions"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^MISSION-[0-9]{3,}$"
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
