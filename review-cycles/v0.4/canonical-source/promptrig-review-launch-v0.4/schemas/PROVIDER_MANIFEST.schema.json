{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptrig.dev/schemas/provider-manifest-0.2.json",
  "title": "ProviderCapabilityManifest",
  "type": "object",
  "required": [
    "manifest_version",
    "provider",
    "verified_at",
    "sources",
    "surfaces",
    "models",
    "capabilities",
    "fallbacks"
  ],
  "properties": {
    "manifest_version": {
      "const": "0.2.0"
    },
    "provider": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "retrieved_at"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "availability"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "availability": {
            "enum": [
              "ga",
              "preview",
              "limited",
              "deprecated",
              "unknown"
            ]
          },
          "context_window": {
            "type": [
              "integer",
              "null"
            ]
          },
          "max_output": {
            "type": [
              "integer",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "string",
          "number",
          "null"
        ]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallbacks": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
