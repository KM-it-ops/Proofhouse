{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptrig.dev/schemas/promptrig-ir-0.2.json",
  "title": "PromptRig Intermediate Representation v0.2",
  "type": "object",
  "required": [
    "spec_version",
    "project",
    "objective",
    "behavior",
    "evaluation"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "0.2.0"
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "balanced",
            "creative",
            "enterprise"
          ]
        },
        "compilation_level": {
          "enum": [
            "prompt",
            "prompt_system",
            "agent_blueprint",
            "application_specification"
          ]
        }
      },
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "required": [
        "goal",
        "success_criteria"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "target_users": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "failure_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "input_contracts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "output_contracts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "behavior": {
      "type": "object",
      "required": [
        "instructions"
      ],
      "properties": {
        "instructions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty_policy": {
          "type": "string"
        },
        "evidence_policy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object"
    },
    "memory": {
      "type": "object"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "workflow": {
      "type": "object"
    },
    "autonomy": {
      "type": "object"
    },
    "security": {
      "type": "object"
    },
    "privacy": {
      "type": "object"
    },
    "provider_requirements": {
      "type": "object"
    },
    "evaluation": {
      "type": "object",
      "required": [
        "dimensions",
        "repair_limit"
      ],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "repair_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "baseline_required": {
          "type": "boolean"
        },
        "test_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
