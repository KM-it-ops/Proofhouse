{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluationCase",
  "type": "object",
  "required": [
    "id",
    "category",
    "input",
    "checks"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "category": {
      "enum": [
        "normal",
        "edge",
        "ambiguous",
        "missing_data",
        "adversarial",
        "prompt_injection",
        "tool_failure",
        "format"
      ]
    },
    "input": {},
    "expected": {},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "json_schema",
              "exact",
              "contains",
              "not_contains",
              "regex",
              "tool_call",
              "citation",
              "rubric"
            ]
          },
          "config": {
            "type": "object"
          },
          "hard_gate": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
